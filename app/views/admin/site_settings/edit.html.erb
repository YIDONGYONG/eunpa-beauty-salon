<% content_for :title, "사이트 설정" %>
<h1>사이트 설정</h1>
<p class="help">여기서 바꾼 내용은 홈페이지의 "찾아오시는 길", 하단 바, 영업시간 안내에 바로 반영됩니다.</p>

<%= form_with model: @setting, url: admin_site_setting_path, method: :patch, class: "admin-form" do |f| %>
  <%= render "admin/shared/errors", record: @setting %>

  <fieldset class="translated-field">
    <legend>첫 화면 배경 사진 (미용실 내부 사진)</legend>
    <% if @setting.hero_photo.attached? %>
      <p><%= image_tag url_for(@setting.hero_photo), class: "admin-thumb", alt: "현재 첫 화면 배경 사진" %></p>
    <% else %>
      <p class="help">아직 사진이 없어 분홍빛 배경이 보입니다. 가로로 넓은 매장 사진을 올리면 바로 바뀝니다.</p>
    <% end %>
    <div class="field">
      <%= f.label :hero_photo, "사진 올리기 (JPG, PNG, WEBP, 5MB 이하)" %>
      <%= f.file_field :hero_photo, accept: "image/jpeg,image/png,image/webp" %>
    </div>
  </fieldset>

  <fieldset class="translated-field">
    <legend>연락처와 지도 위치</legend>
    <div class="field">
      <%= f.label :phone, "전화번호 (예: 02-1234-5678)" %>
      <%= f.telephone_field :phone %>
    </div>
    <div class="grid-2">
      <div class="field">
        <%= f.label :latitude, "위도 (예: 37.5665)" %>
        <%= f.text_field :latitude, inputmode: "decimal" %>
      </div>
      <div class="field">
        <%= f.label :longitude, "경도 (예: 126.9780)" %>
        <%= f.text_field :longitude, inputmode: "decimal" %>
      </div>
    </div>
    <p class="help">위도·경도는 네이버 지도에서 가게 위치를 우클릭하거나 길게 눌러 확인할 수 있습니다.</p>
  </fieldset>

  <%= render "admin/shared/translated_field", f: f, attr: :tagline, label: "한 줄 인사말 (홈 화면 맨 위)" %>
  <%= render "admin/shared/translated_field", f: f, attr: :address, label: "주소", as: :text %>
  <%= render "admin/shared/translated_field", f: f, attr: :hours, label: "영업시간", as: :text %>
  <%= render "admin/shared/translated_field", f: f, attr: :closed_days, label: "휴무일", as: :text %>
  <%= render "admin/shared/translated_field", f: f, attr: :parking, label: "주차 안내", as: :text %>
  <%= render "admin/shared/translated_field", f: f, attr: :entrance, label: "입구 찾는 법", as: :text %>
  <%= render "admin/shared/translated_field", f: f, attr: :business_info, label: "사업자 정보 (화면 맨 아래에 표시)", as: :text,
                hint: "상호, 대표자, 사업자등록번호 등을 입력하세요." %>

  <div class="form-actions">
    <%= f.submit "저장", class: "btn btn-primary" %>
    <%= link_to "취소", admin_root_path, class: "btn btn-outline" %>
  </div>
<% end %>

<% if @setting.hero_photo.attached? %>
  <%= button_to "첫 화면 사진 삭제", hero_photo_admin_site_setting_path, method: :delete, class: "btn btn-danger",
                form: { data: { turbo_confirm: "첫 화면 배경 사진을 삭제할까요?" } } %>
<% end %>
