<%= form_with url: admin_session_path, class: "admin-form" do |f| %>
  <div class="field">
    <%= f.label :email, "이메일" %>
    <%= f.email_field :email, autocomplete: "username", required: true, autofocus: true, value: params[:email] %>
  </div>
  <div class="field">
    <%= f.label :password, "비밀번호" %>
    <%= f.password_field :password, autocomplete: "current-password", required: true %>
  </div>
  <%= f.submit "로그인", class: "btn btn-primary btn-block" %>
<% end %>
