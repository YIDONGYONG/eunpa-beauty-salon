<% page_title t("about.title") %>
<% page_description t("about.meta_description") %>

<section class="section">
  <div class="container">
    <h1 class="page-title"><%= t("about.title") %></h1>

    <div class="owner">
      <% if owner_profile.show_photo_on_home? && owner_profile.photo.attached? %>
        <%= salon_image_tag owner_profile.photo, width: 640, class: "owner-photo", alt: t("about.photo_alt") %>
      <% end %>
      <div>
        <h2 class="section-title"><%= t("about.owner_title") %></h2>
        <p class="owner-name"><%= owner_profile.name %></p>
        <p class="badge"><%= t("about.years", years: owner_profile.years_of_experience) %></p>
        <% greeting = owner_profile.random_greeting %>
        <%= translation_fallback_notice(owner_profile.name_translated? || greeting&.body_translated?) %>
        <% if owner_profile.headline.present? %>
          <p class="lead"><%= owner_profile.headline %></p>
        <% end %>
      </div>
    </div>

    <%# あいさつ文は複数登録でき、表示のたびにランダムで1つ選ばれます %>
    <% if greeting %>
      <h2 class="section-title"><%= t("about.greeting_title") %></h2>
      <div class="prose"><%= multiline greeting.body %></div>
    <% end %>

    <% if owner_profile.career.present? %>
      <h2 class="section-title"><%= t("about.career_title") %></h2>
      <div class="prose"><%= multiline owner_profile.career %></div>
    <% end %>
  </div>
</section>

<section class="section section-alt" aria-labelledby="gallery-title">
  <div class="container">
    <h2 id="gallery-title" class="section-title"><%= t("about.gallery_title") %></h2>
    <% if @gallery_images.any? %>
      <ul class="gallery">
        <% @gallery_images.each do |image| %>
          <li><%= salon_image_tag image, width: 800, alt: t("about.gallery_title") %></li>
        <% end %>
      </ul>
    <% else %>
      <div class="gallery-empty">
        <%= image_tag "gallery-placeholder.svg", alt: "", loading: "lazy" %>
        <p><%= t("about.gallery_empty") %></p>
      </div>
    <% end %>
  </div>
</section>

