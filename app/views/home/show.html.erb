<% page_description t("home.meta_description") %>

<section class="hero <%= "has-photo" if site_setting.hero_photo.attached? %>">
  <% if site_setting.hero_photo.attached? %>
    <%= salon_image_tag site_setting.hero_photo, width: 1600, class: "hero-photo", alt: "", "aria-hidden": "true", loading: "eager" %>
  <% else %>
    <div class="hero-art" aria-hidden="true"><%= render "shared/flower", size: 360 %></div>
  <% end %>
  <div class="container">
    <div class="hero-card">
      <div class="hero-flower"><%= render "shared/flower", size: 88 %></div>
      <p class="hero-hello"><%= t("home.hero_hello") %></p>
      <h1 class="hero-title"><%= t("site.name") %></h1>
      <p class="hero-tagline"><%= site_setting.tagline.presence || t("site.default_tagline") %></p>
      <div class="button-row">
        <%= render "shared/contact_buttons" %>
      </div>
    </div>
  </div>
</section>

<section class="section" id="prices" aria-labelledby="prices-title">
  <div class="container">
    <p class="eyebrow"><%= t("home.price_eyebrow") %></p>
    <h2 id="prices-title" class="section-title"><%= t("home.price_title") %></h2>
    <% if @price_list.empty? %>
      <p><%= t("home.price_empty") %></p>
    <% else %>
      <div class="price-grid">
        <% @price_list.each_with_index do |(category, items), index| %>
          <article class="price-card <%= "price-card-wide" if [ 0, 3 ].include?(index % 4) %>">
            <span class="icon-tile" aria-hidden="true"><svg viewBox="0 0 24 24" width="26" height="26"><circle cx="6" cy="6.5" r="2.6" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="6" cy="17.5" r="2.6" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M8.2 8 20 19M8.2 16 20 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span>
            <h3 class="price-card-title"><%= category.name %></h3>
            <ul class="price-list">
              <% items.each do |item| %>
                <li>
                  <div class="price-row">
                    <span class="price-name"><%= item.name %></span>
                    <span class="price-value"><%= format_price(item) %></span>
                  </div>
                  <% if item.description.present? %>
                    <p class="price-desc"><%= item.description %></p>
                  <% end %>
                </li>
              <% end %>
            </ul>
          </article>
        <% end %>
      </div>
      <p class="price-note"><%= t("home.price_note") %></p>
    <% end %>
  </div>
</section>

<section class="section section-alt" aria-labelledby="about-title">
  <div class="container about-summary">
    <% if owner_profile.photo.attached? %>
      <%= salon_image_tag owner_profile.photo, width: 480, class: "owner-photo", alt: t("about.photo_alt") %>
    <% else %>
      <%= image_tag "owner-placeholder.svg", class: "owner-photo", alt: t("about.photo_alt"), loading: "lazy" %>
    <% end %>
    <div>
      <p class="eyebrow"><%= t("home.about_eyebrow") %></p>
      <h2 id="about-title" class="section-title"><%= t("home.about_title") %></h2>
      <p class="badge"><%= t("about.years", years: owner_profile.years_of_experience) %></p>
      <%= multiline owner_profile.headline.presence || owner_profile.greeting.to_s.truncate(120) %>
      <p><%= link_to t("home.about_more"), about_path, class: "btn btn-outline" %></p>
    </div>
  </div>
</section>

<section class="section" aria-labelledby="posts-title">
  <div class="container">
    <p class="eyebrow"><%= t("home.posts_eyebrow") %></p>
    <h2 id="posts-title" class="section-title"><%= t("home.posts_title") %></h2>
    <% if @recent_posts.any? %>
      <div class="post-grid">
        <%= render partial: "posts/card", collection: @recent_posts, as: :post %>
      </div>
      <p><%= link_to t("home.posts_more"), posts_path, class: "btn btn-outline" %></p>
    <% else %>
      <p><%= t("blog.empty") %></p>
    <% end %>
  </div>
</section>

<section class="section section-green" aria-labelledby="info-title">
  <div class="container">
    <p class="eyebrow"><%= t("home.info_eyebrow") %></p>
    <h2 id="info-title" class="section-title"><%= t("home.info_title") %></h2>
    <dl class="info-list">
      <div>
        <dt><%= t("home.hours") %></dt>
        <dd><%= site_setting.hours.present? ? multiline(site_setting.hours) : t("home.info_empty") %></dd>
      </div>
      <div>
        <dt><%= t("home.closed") %></dt>
        <dd><%= site_setting.closed_days.present? ? multiline(site_setting.closed_days) : t("home.info_empty") %></dd>
      </div>
    </dl>
  </div>
</section>
