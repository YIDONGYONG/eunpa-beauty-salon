# 이 파일을 .env 로 복사한 뒤 값을 채우세요:  cp .env.example .env
# (.env 는 git에 올리지 않습니다. 배포 서버가 정해지면 서버의 환경변수로 같은 값을 설정하세요.)

# --- 첫 관리자 계정 (db:seed 실행 시 한 번만 생성됩니다) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# --- 네이버 지도 (Naver Cloud Platform > Maps > Application 의 Client ID) ---
NAVER_MAP_CLIENT_ID=
# 네이버 지도 앱 길 안내 URL 스킴의 appname (보통 사이트 도메인을 거꾸로 쓴 값)
NAVER_APP_NAME=kr.eunpa.salon

# --- 사이트 주소 (sitemap.xml, OG 태그, canonical 에 사용. 예: https://example.com) ---
APP_BASE_URL=

# --- 업로드 이미지 최대 크기(MB, 축소 전 원본 기준) ---
UPLOAD_MAX_MB=5
# 업로드 사진 자동 축소 (긴 변 px / JPEG·WEBP 품질)
IMAGE_MAX_EDGE=1600
IMAGE_QUALITY=82

# --- 저사양 서버(RAM 1GB)용 메모리 절약 ---
# RAILS_MAX_THREADS=2
# WEB_CONCURRENCY=0
# RAILS_YJIT=false
# MALLOC_ARENA_MAX=2

# --- 데이터 저장 위치 (SQLite 파일). 기본 storage/ (Docker 개발에서는 바꿀 필요 없음) ---
# DATA_DIR=storage

# --- 운영 환경변수(SECRET_KEY_BASE, LITESTREAM_REPLICA_URL, APP_HOST 등)는 deploy/env.production.example 참고 ---
