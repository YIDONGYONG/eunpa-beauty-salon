# 環境変数・秘密の値
/.env
/.env.*
!/.env.example
/config/master.key
/config/credentials/*.key

# ログ・一時ファイル・アップロードファイル
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

/public/assets
.byebug_history
.DS_Store
/node_modules
/db/*.sqlite3*

# 個人の写真（公開リポジトリに載せない）。本人の許可を得た写真だけを管理画面からアップロードする
/db/seed_images/owner.jpg
/app/assets/images/Owner.JPG
/app/assets/images/kosumosu.png
app/assets/images/cut.png
app/assets/images/perm.png
app/assets/images/hair.png
app/assets/images/logo.png
app/assets/images/makeup.png
# 분류 아이콘(출처·이용 조건 확인 전까지 공개하지 않음). 시드는 파일이 없으면 아이콘 없이 진행합니다.
/db/seed_images/category-*.png
