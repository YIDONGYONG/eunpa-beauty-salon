{
  "permissions": {
    "allow": [
      "Bash(bin/rails test*)",
      "Bash(bin/rails db:*)",
      "Bash(bin/rails routes*)",
      "Bash(bin/rails runner*)",
      "Bash(bin/verify)",
      "Bash(bundle exec rubocop*)",
      "Bash(bundle exec brakeman*)",
      "Bash(bundle install)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(docker compose up*)",
      "Bash(docker compose down)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./config/master.key)",
      "Bash(docker compose down -v*)",
      "Bash(bin/rails db:drop*)",
      "Bash(git push --force*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [ { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/protect_files.sh" } ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [ { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/after_edit.sh" } ]
      }
    ]
  }
}
