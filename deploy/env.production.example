# 本番の環境変数（VM の /opt/eunpa/.env に置く。値はリポジトリへコミットしない）
# ---- 必須 ----
SECRET_KEY_BASE=CHANGE_ME_run_bin_rails_secret
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=CHANGE_ME_long_password   # 初回シードだけで使う。ログイン後に管理画面で変更
RUN_SEED=true                             # 初回起動だけ true。管理者作成後は false に
# ---- ドメインが決まったら ----
APP_HOST=eunpabeautysalon.duckdns.org          # サイトのホスト名（Caddy の証明書取得にも使う）
APP_BASE_URL=https://eunpabeautysalon.duckdns.org   # sitemap / canonical / OG で使う
FORCE_SSL=true                            # Caddy が HTTPS を終端する前提
# ---- バックアップ（Litestream → AWS S3。ソウル: ap-northeast-2）----
LITESTREAM_REPLICA_URL=s3://BUCKET_NAME/eunpa/production
LITESTREAM_ACCESS_KEY_ID=CHANGE_ME      # このバケットだけに権限を絞った IAM ユーザーのキー
LITESTREAM_SECRET_ACCESS_KEY=CHANGE_ME
AWS_REGION=ap-northeast-2
# ---- 検索サイトの所有確認（NAVER サーチアドバイザ / Google Search Console が発行する値）----
NAVER_SITE_VERIFICATION=
GOOGLE_SITE_VERIFICATION=
# ---- 地図・ナビ ----
NAVER_MAP_CLIENT_ID=
NAVER_APP_NAME=kr.eunpa.salon
# ---- エラー通知メール（任意）----
ERROR_NOTIFY_EMAIL=
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@example.com
# ---- メモリ・画像 ----
UPLOAD_MAX_MB=5
IMAGE_MAX_EDGE=1600
IMAGE_QUALITY=82
